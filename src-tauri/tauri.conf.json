{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restyle",
  "version": "0.1.0",
  "identifier": "dev.reva1v.restyle",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Restyle",
        "width": 520,
        "height": 148,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "menu",
        "title": "Restyle menu",
        "url": "menu.html",
        "width": 272,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Reva1v",
    "copyright": "© 2026 Reva1v",
    "category": "Productivity",
    "shortDescription": "Переписывание набранного текста через AI",
    "longDescription": "Restyle переписывает текст прямо в поле ввода любого приложения: хоткей — выбор стиля — готовый текст на месте исходного. Контекст берётся со снимка активного окна, ключ Gemini хранится в Windows Credential Manager.",
    "windows": {
      "wix": {
        "language": [
          "ru-RU",
          "en-US"
        ]
      },
      "allowDowngrades": true
    }
  }
}
